<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar version of the ringing bell.

  Android throws away colour here and keeps only the alpha, so this is a flat
  white silhouette. The bell is drawn smaller than in the launcher icon to
  leave a readable gap before the motion arcs — at 24dp they otherwise merge
  into it — and its stroke is set to 2.74 inside a 0.62 group so it still
  renders at about 1.7dp rather than thinning to a hairline.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:translateX="4.56"
        android:translateY="5.06"
        android:scaleX="0.62"
        android:scaleY="0.62">
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.74"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M6,8 a6,6 0 0 1 12,0 c0,7 3,9 3,9 H3 s3,-2 3,-9" />
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.74"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M10.3,21 a1.94,1.94 0 0 0 3.4,0" />
    </group>

    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M5,9.5 a2.4,2.4 0 0 0 0,4.8" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M19,9.5 a2.4,2.4 0 0 1 0,4.8" />
</vector>
