<?xml version="1.0" encoding="utf-8"?>
<!--
  The ringing bell in flat black for Android 13+ themed icons; the system
  tints this to match the user's wallpaper palette. Geometry is identical to
  ic_launcher_foreground.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The bell, drawn in its native 24-unit box and scaled up. -->
    <group
        android:translateX="37.2"
        android:translateY="37.2"
        android:scaleX="1.4"
        android:scaleY="1.4">
        <path
            android:strokeColor="#000000"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M6,8 a6,6 0 0 1 12,0 c0,7 3,9 3,9 H3 s3,-2 3,-9" />
        <path
            android:strokeColor="#000000"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M10.3,21 a1.94,1.94 0 0 0 3.4,0" />
    </group>

    <!-- Sound coming off it. -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M36,46 a10,10 0 0 0 0,16" />
    <path
        android:strokeColor="#000000"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M72,46 a10,10 0 0 1 0,16" />
</vector>
