#!/usr/bin/env bash
# Refuse to push if the deterministic test suite is red.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass in an emergency: git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

export ANDROID_HOME=/opt/homebrew/share/android-commandlinetools
export PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"

echo "pre-push: running deterministic JVM tests…"
if ! ./gradlew --quiet --console=plain :app:testDebugUnitTest; then
  echo >&2
  echo "pre-push: tests failed — push aborted." >&2
  echo "pre-push: fix them, or bypass with 'git push --no-verify'." >&2
  exit 1
fi
echo "pre-push: tests green."
