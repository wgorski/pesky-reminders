{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-change.sh\"",
            "statusMessage": "Running deterministic tests",
            "timeout": 300,
            "asyncRewake": true,
            "rewakeSummary": "Deterministic tests failed"
          }
        ]
      }
    ]
  }
}
